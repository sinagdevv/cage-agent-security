# CAGE Environment Configuration (Example)
# Copy to .env for local development

# Application Configuration
CAGE_ENV=development
CAGE_DEBUG=true
CAGE_HOST=0.0.0.0
CAGE_PORT=8000
CAGE_LOG_LEVEL=INFO

# Security & Secrets
CAGE_SECRET_KEY=change-this-in-production-cage-secret-key-32-chars-min
CAGE_API_KEY=cage_dev_test_api_key

# PostgreSQL Database
POSTGRES_USER=cage_user
POSTGRES_PASSWORD=cage_password
POSTGRES_DB=cage_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cage_user:cage_password@localhost:5432/cage_db

# Redis State & Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Open Policy Agent (OPA)
OPA_HOST=opa
OPA_PORT=8181
OPA_URL=http://localhost:8181

# LLM Providers (OpenAI Compatible & Ollama)
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3

# Frontend Dashboard
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
